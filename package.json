{
  "name": "ai-ssh-pro",
  "displayName": "AI-SSH-Pro",
  "description": "Multi-session SSH client for VS Code / Cursor: SFTP, ProxyJump, port forward, Docker, inventory, snippets",
  "version": "0.1.1",
  "publisher": "guoshuaipeng",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/guoshuaipeng/ai-ssh-pro-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/guoshuaipeng/ai-ssh-pro-vscode/issues"
  },
  "homepage": "https://github.com/guoshuaipeng/ai-ssh-pro-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Terminal"
  ],
  "keywords": [
    "ssh",
    "sftp",
    "terminal",
    "docker",
    "xshell"
  ],
  "activationEvents": [
    "onView:aiSshPro.sessions",
    "onView:aiSshPro.inventory",
    "onView:aiSshPro.docker",
    "onCommand:aiSshPro.connect",
    "onCommand:aiSshPro.openLocalShell"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiSshPro",
          "title": "AI-SSH-Pro",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiSshPro": [
        {
          "id": "aiSshPro.sessions",
          "name": "Sessions"
        },
        {
          "id": "aiSshPro.docker",
          "name": "Docker"
        },
        {
          "id": "aiSshPro.inventory",
          "name": "Host Inventory"
        },
        {
          "id": "aiSshPro.snippets",
          "name": "Snippets"
        }
      ]
    },
    "commands": [
      {
        "command": "aiSshPro.connect",
        "title": "AI-SSH-Pro: New SSH Connection",
        "icon": "$(plug)"
      },
      {
        "command": "aiSshPro.connectProfile",
        "title": "Connect",
        "icon": "$(debug-start)"
      },
      {
        "command": "aiSshPro.disconnect",
        "title": "Disconnect",
        "icon": "$(debug-stop)"
      },
      {
        "command": "aiSshPro.reconnect",
        "title": "Reconnect",
        "icon": "$(refresh)"
      },
      {
        "command": "aiSshPro.saveSession",
        "title": "Save Session Profile"
      },
      {
        "command": "aiSshPro.editProfile",
        "title": "Edit Profile"
      },
      {
        "command": "aiSshPro.deleteProfile",
        "title": "Delete Profile",
        "icon": "$(trash)"
      },
      {
        "command": "aiSshPro.newFolder",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "aiSshPro.deleteFolder",
        "title": "Delete Folder"
      },
      {
        "command": "aiSshPro.openSftp",
        "title": "Open SFTP",
        "icon": "$(cloud)"
      },
      {
        "command": "aiSshPro.openLocalShell",
        "title": "AI-SSH-Pro: Local Shell",
        "icon": "$(terminal)"
      },
      {
        "command": "aiSshPro.importSessions",
        "title": "AI-SSH-Pro: Import Sessions"
      },
      {
        "command": "aiSshPro.exportJson",
        "title": "AI-SSH-Pro: Export Sessions (JSON)"
      },
      {
        "command": "aiSshPro.exportOpenSsh",
        "title": "AI-SSH-Pro: Export Sessions (OpenSSH)"
      },
      {
        "command": "aiSshPro.toggleRecording",
        "title": "Toggle Session Recording"
      },
      {
        "command": "aiSshPro.terminalPrefs",
        "title": "AI-SSH-Pro: Terminal Preferences"
      },
      {
        "command": "aiSshPro.refreshDocker",
        "title": "Refresh Docker",
        "icon": "$(refresh)"
      },
      {
        "command": "aiSshPro.dockerExec",
        "title": "Docker Exec Shell",
        "icon": "$(terminal)"
      },
      {
        "command": "aiSshPro.dockerAction",
        "title": "Docker Container Action"
      },
      {
        "command": "aiSshPro.dockerLogs",
        "title": "Docker Logs"
      },
      {
        "command": "aiSshPro.dockerInspect",
        "title": "Docker Inspect"
      },
      {
        "command": "aiSshPro.dockerComposeAction",
        "title": "Docker Compose Up/Down"
      },
      {
        "command": "aiSshPro.dockerSwarmAction",
        "title": "Docker Swarm Service Action"
      },
      {
        "command": "aiSshPro.addInventoryService",
        "title": "Add Host Service"
      },
      {
        "command": "aiSshPro.copyTerminalSnapshot",
        "title": "AI-SSH-Pro: Copy Terminal Snapshot"
      },
      {
        "command": "aiSshPro.addSnippet",
        "title": "Add Snippet",
        "icon": "$(add)"
      },
      {
        "command": "aiSshPro.runSnippet",
        "title": "Run Snippet",
        "icon": "$(play)"
      },
      {
        "command": "aiSshPro.editSnippet",
        "title": "Edit Snippet"
      },
      {
        "command": "aiSshPro.deleteSnippet",
        "title": "Delete Snippet",
        "icon": "$(trash)"
      },
      {
        "command": "aiSshPro.refreshInventory",
        "title": "Refresh Inventory",
        "icon": "$(refresh)"
      },
      {
        "command": "aiSshPro.upsertInventoryHost",
        "title": "Add / Edit Host Profile"
      },
      {
        "command": "aiSshPro.openInventoryHost",
        "title": "Open Host Profile"
      },
      {
        "command": "aiSshPro.deleteInventoryHost",
        "title": "Delete Host Profile",
        "icon": "$(trash)"
      },
      {
        "command": "aiSshPro.searchInventory",
        "title": "AI-SSH-Pro: Search Inventory",
        "icon": "$(search)"
      },
      {
        "command": "aiSshPro.appendInventoryNote",
        "title": "Append Note"
      },
      {
        "command": "aiSshPro.linkInventory",
        "title": "Link Inventory to Profile"
      },
      {
        "command": "aiSshPro.moveProfile",
        "title": "Move to Folder"
      },
      {
        "command": "aiSshPro.broadcast",
        "title": "AI-SSH-Pro: Broadcast to SSH Sessions"
      },
      {
        "command": "aiSshPro.showMcpGuide",
        "title": "AI-SSH-Pro: MCP Inventory Guide"
      },
      {
        "command": "aiSshPro.refreshSessions",
        "title": "Refresh Sessions",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiSshPro.connect",
          "when": "view == aiSshPro.sessions",
          "group": "navigation@1"
        },
        {
          "command": "aiSshPro.newFolder",
          "when": "view == aiSshPro.sessions",
          "group": "navigation@2"
        },
        {
          "command": "aiSshPro.refreshSessions",
          "when": "view == aiSshPro.sessions",
          "group": "navigation@3"
        },
        {
          "command": "aiSshPro.refreshDocker",
          "when": "view == aiSshPro.docker",
          "group": "navigation"
        },
        {
          "command": "aiSshPro.addSnippet",
          "when": "view == aiSshPro.snippets",
          "group": "navigation"
        },
        {
          "command": "aiSshPro.searchInventory",
          "when": "view == aiSshPro.inventory",
          "group": "navigation@1"
        },
        {
          "command": "aiSshPro.refreshInventory",
          "when": "view == aiSshPro.inventory",
          "group": "navigation@2"
        },
        {
          "command": "aiSshPro.upsertInventoryHost",
          "when": "view == aiSshPro.inventory",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "aiSshPro.connectProfile",
          "when": "view == aiSshPro.sessions && viewItem == profile",
          "group": "inline@1"
        },
        {
          "command": "aiSshPro.openSftp",
          "when": "view == aiSshPro.sessions && viewItem == activeSession",
          "group": "inline@1"
        },
        {
          "command": "aiSshPro.reconnect",
          "when": "view == aiSshPro.sessions && viewItem == activeSession",
          "group": "inline@2"
        },
        {
          "command": "aiSshPro.disconnect",
          "when": "view == aiSshPro.sessions && viewItem == activeSession",
          "group": "inline@3"
        },
        {
          "command": "aiSshPro.toggleRecording",
          "when": "view == aiSshPro.sessions && viewItem == activeSession",
          "group": "1_mod@1"
        },
        {
          "command": "aiSshPro.editProfile",
          "when": "view == aiSshPro.sessions && viewItem == profile",
          "group": "1_mod@1"
        },
        {
          "command": "aiSshPro.moveProfile",
          "when": "view == aiSshPro.sessions && viewItem == profile",
          "group": "1_mod@2"
        },
        {
          "command": "aiSshPro.deleteProfile",
          "when": "view == aiSshPro.sessions && viewItem == profile",
          "group": "1_mod@3"
        },
        {
          "command": "aiSshPro.deleteFolder",
          "when": "view == aiSshPro.sessions && viewItem == folder",
          "group": "1_mod"
        },
        {
          "command": "aiSshPro.dockerExec",
          "when": "view == aiSshPro.docker && viewItem == dockerContainer",
          "group": "inline@1"
        },
        {
          "command": "aiSshPro.dockerLogs",
          "when": "view == aiSshPro.docker && viewItem == dockerContainer",
          "group": "1_actions@1"
        },
        {
          "command": "aiSshPro.dockerInspect",
          "when": "view == aiSshPro.docker && viewItem == dockerContainer",
          "group": "1_actions@2"
        },
        {
          "command": "aiSshPro.dockerAction",
          "when": "view == aiSshPro.docker && viewItem == dockerContainer",
          "group": "1_actions@3"
        },
        {
          "command": "aiSshPro.dockerComposeAction",
          "when": "view == aiSshPro.docker && viewItem == dockerCompose",
          "group": "1_actions"
        },
        {
          "command": "aiSshPro.dockerSwarmAction",
          "when": "view == aiSshPro.docker && viewItem == dockerSwarm",
          "group": "1_actions"
        },
        {
          "command": "aiSshPro.runSnippet",
          "when": "view == aiSshPro.snippets && viewItem == snippet",
          "group": "inline@1"
        },
        {
          "command": "aiSshPro.editSnippet",
          "when": "view == aiSshPro.snippets && viewItem == snippet",
          "group": "1_mod@1"
        },
        {
          "command": "aiSshPro.deleteSnippet",
          "when": "view == aiSshPro.snippets && viewItem == snippet",
          "group": "1_mod@2"
        },
        {
          "command": "aiSshPro.openInventoryHost",
          "when": "view == aiSshPro.inventory && viewItem == inventoryHost",
          "group": "inline@1"
        },
        {
          "command": "aiSshPro.appendInventoryNote",
          "when": "view == aiSshPro.inventory && viewItem == inventoryHost",
          "group": "1_mod@1"
        },
        {
          "command": "aiSshPro.addInventoryService",
          "when": "view == aiSshPro.inventory && viewItem == inventoryHost",
          "group": "1_mod@2"
        },
        {
          "command": "aiSshPro.deleteInventoryHost",
          "when": "view == aiSshPro.inventory && viewItem == inventoryHost",
          "group": "1_mod@3"
        }
      ],
      "commandPalette": [
        {
          "command": "aiSshPro.connectProfile",
          "when": "false"
        },
        {
          "command": "aiSshPro.dockerAction",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "AI-SSH-Pro",
      "properties": {
        "aiSshPro.inventoryRoot": {
          "type": "string",
          "default": "",
          "description": "Override host inventory root (default: ~/.ai-ssh-pro/inventory). Env AISS_INVENTORY_ROOT also works."
        },
        "aiSshPro.defaultPort": {
          "type": "number",
          "default": 22,
          "description": "Default SSH port for new connections."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc -p ./ --noEmit",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "publish:vscode": "vsce publish --allow-missing-repository",
    "mcp:inventory": "node scripts/mcp-inventory-server.mjs"
  },
  "dependencies": {
    "ssh2": "^1.16.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
